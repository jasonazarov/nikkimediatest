+.nmw-camp-hero__row-chip {
+  flex: none; padding: 3px 10px; border-radius: 999px; font-size: .72rem; font-weight: 700; color: #d6fde9;
+  background: rgba(47, 224, 140, .16); box-shadow: inset 0 0 0 1px rgba(47, 224, 140, .45);
+}
+.nmw-camp-hero__row-go { flex: none; color: #9cf6c8; font-weight: 800; transition: transform .15s ease; }
+.nmw-camp-hero__row:hover .nmw-camp-hero__row-go { transform: translateX(3px); }
+@media (max-width: 640px) { .nmw-camp-hero__row-chip { display: none; } }
+@media (prefers-reduced-motion: reduce) { .nmw-camp-hero__row, .nmw-camp-hero__row-go { transition: none; } }
