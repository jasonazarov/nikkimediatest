{
  "name": "nikki-media",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "ship": "bash scripts/ship.sh",
    "deploy": "wrangler deploy",
    "test": "node scripts/login-test.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply nikki-media --local",
    "db:migrate:remote": "wrangler d1 migrations apply nikki-media --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.10.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.0"
  }
}
