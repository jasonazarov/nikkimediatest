# ---------------------------------------------------------------------------
# Nikki Media — Umgebungsvariablen
#
# Für die lokale Entwicklung: Datei nach `.dev.vars` kopieren und ausfüllen.
# Für Produktion: jeden Wert einzeln per `npx wrangler secret put <NAME>` setzen.
# `.dev.vars` ist in .gitignore und darf NIE committet werden.
# ---------------------------------------------------------------------------

# Pepper für Login-Code- und Session-Token-Hashes (HMAC-SHA256).
# Erzeugen:  openssl rand -hex 32
AUTH_SECRET=

# Resend API-Key für den E-Mail-Versand (https://resend.com/api-keys)
RESEND_API_KEY=

# R2 S3-API-Zugangsdaten für presigned Upload-/Download-URLs.
# Cloudflare-Dashboard → R2 → "Manage API Tokens" → Object-Read-&-Write.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# bundle.social — Veröffentlichung fertiger Clips.
# API-Schlüssel aus dem dortigen Dashboard, Bereich "API Keys".
# Fehlt er, ruht die Anbindung: Projekte und Uploads funktionieren
# unverändert, es geht nur nichts nach draußen.
BUNDLE_API_KEY=

# Signaturgeheimnis für eingehende Webhooks. Wird dort erst ANGEZEIGT,
# nachdem die Adresse https://nikkimedia.co/api/webhooks/bundle-social
# unter Organisation → Webhooks eingetragen wurde.
BUNDLE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Diese Werte stehen bereits in wrangler.toml unter [vars] und müssen nur
# angepasst werden, wenn sich Domain, Absender oder Bucket ändern:
#
# APP_URL=https://nikkimedia.co
# MAIL_FROM=Nikki Media <noreply@nikkimedia.co>
# ADMIN_EMAIL=jason.azarov@outlook.at
# ADMIN_NAME=Jason Azarov
# R2_BUCKET=nikki-media
# R2_PUBLIC_ACCOUNT_ID=c80a29b391c87cab55592199b80c7663
# STORAGE_WARN_BYTES=107374182400
# ---------------------------------------------------------------------------

# Optional: FAQ-Agent mit Sprachmodell (ohne Schlüssel antwortet er per FAQ-Abgleich)
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-haiku-5-5
